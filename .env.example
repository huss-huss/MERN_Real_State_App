# API (copy to .env and fill in; never commit real values)
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/real-estate
# Use a long random string, e.g. `openssl rand -hex 32` (>= 32 chars required in production)
JWT_SECRET=change-me
# Firebase project id used to verify Google sign-in ID tokens
FIREBASE_PROJECT_ID=your-firebase-project-id
# Comma-separated origins allowed to call the API cross-origin (same-origin needs nothing)
CORS_ORIGINS=
# Set to the number of reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=
# Optional rate limit overrides
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
